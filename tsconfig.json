{
  "compilerOptions": {
    "types": [
      "screeps",
      "node",
      "lodash"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "target": "es2019",
    "lib": ["ES2019", "DOM"],
    "moduleResolution": "Node",
    "outDir": "dist/",
    "baseUrl": "./",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.js"
  ]
}